# Database Configuration (Turso)
DATABASE_URL=libsql://your-database-url.turso.io
DATABASE_AUTH_TOKEN=your-auth-token-here
# Dapetin di: https://turso.tech/app

# Bot Configuration
OWNER=628123456789
# Tanpa tanda + dan tanpa @s.whatsapp.net
# Contoh: 628123456789 atau 6281234567890

# Bot Mode
isSelf=false
# true = hanya owner yang bisa pakai bot
# false = semua orang bisa pakai bot

# Bot Name (Optional)
BOT_NAME=WhatsApp Bot
